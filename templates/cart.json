{"sections":{"main-cart":{"type":"main-cart","blocks":{"free_shipping_goal_W8bXKE":{"type":"free_shipping_goal","settings":{}},"cart_note_qpALBg":{"type":"cart_note","settings":{}},"cart_shipping_rate_bnhQBk":{"type":"cart_shipping_rate","settings":{}},"subtotal_LeUiVY":{"type":"subtotal","settings":{}},"buttons_drwbch":{"type":"buttons","settings":{}}},"block_order":["free_shipping_goal_W8bXKE","cart_note_qpALBg","cart_shipping_rate_bnhQBk","subtotal_LeUiVY","buttons_drwbch"],"settings":{"padding_top":100,"padding_bottom":100}},"custom_liquid_TJVwUd":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<!-- Begin: Agree to Return Policy Checkbox (Centered Version) -->\n<div id=\"agree-to-policy-wrapper\" style=\"margin-top: 30px; text-align: center;\">\n  <label style=\"display: inline-flex; align-items: center; justify-content: center; font-size: 15px;\">\n    <input type=\"checkbox\" id=\"agreePolicyCheckbox\" style=\"margin-right: 10px; transform: scale(1.2);\" \/>\n    I have read and agree to the \n    <a href=\"\/policies\/refund-policy\" target=\"_blank\" style=\"color: #ff69b4; text-decoration: underline; margin-left: 5px;\">\n      Return & Refund Policy\n    <\/a>\n  <\/label>\n  <p id=\"policyWarning\" style=\"color: red; display: none; margin-top: 10px;\">Please agree to the return policy before proceeding to checkout.<\/p>\n<\/div>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var checkoutButton = document.querySelector('form[action$=\"\/cart\"] [type=\"submit\"]') || document.querySelector('button[name=\"checkout\"]');\n    var checkbox = document.getElementById('agreePolicyCheckbox');\n    var warning = document.getElementById('policyWarning');\n\n    if (checkoutButton && checkbox) {\n      checkoutButton.addEventListener('click', function (e) {\n        if (!checkbox.checked) {\n          e.preventDefault();\n          warning.style.display = 'block';\n          window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });\n        }\n      });\n    }\n  });\n<\/script>\n<!-- End: Agree to Return Policy Checkbox -->","color_scheme":"","padding_top":50,"padding_bottom":50}},"featured_collection_Y4GDWA":{"type":"featured-collection","settings":{"color_scheme":"","header_layout":"vertical","heading":"You may also like","heading_size":"h1","heading_highlight_style":"none","subheading":"","description":"","text_size":"text-base","show_collection_description":false,"collection":"","limit":4,"columns":4,"column_gap":"extra-small","row_gap":"inherit","grid_layout":"standard","enable_slider":true,"controls_position":"inside","pcard_image_ratio":"","columns_mobile":"1","swipe_on_mobile":true,"show_all_button_on_top":false,"button_label":"","button_style":"btn--primary","padding_top":0,"padding_bottom":100,"show_section_divider":false,"divider_width":"fixed"}}},"order":["main-cart","custom_liquid_TJVwUd","featured_collection_Y4GDWA"]}