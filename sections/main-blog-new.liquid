{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
<style>
  .main-blog-new {
    margin: 100px 0;
  }
  .main-blog-new p {
    margin: 0;
  }
  ul.blog-menu {
    margin: 0;
  }
  ul.blog-menu li {
    color: #b3848f;
    list-style: none;
    padding: 10px 20px;
    border: 1px solid #b3848f;
    text-align: center;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
  }
  ul.blog-menu li.active {
    color: #b3848f;
    background-color: #f8f1f4;
    font-weight: 600;
  }
  .blog-lists {
    margin-top: 50px;
  }
  .blog-list-box {
    /* display: none; */
  }
</style>
<div class="main-blog-new section section--padding">
  <div class="main-blog-new-content page-width">
    <div class="main-blog__block main-blog__tags">
      <div class="swipe-mobile text-center">
        <ul class="blog-menu inline-flex items-center flex-nowrap md:flex-wrap font-navigation">
          <li class="{% unless current_tags %}active{% endunless %}">
            <a href="{{ blog.url }}">All</a>
          </li>
          {% for tag in blog.all_tags %}
            <li
              class="blog-menu-item blog-menu-{{ forloop.index }} {% if current_tags contains tag %}active{% endif %}"
              data-handle="{{ tag }}"
            >
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="blog-lists">
      {%- paginate blog.articles by 6 -%}
        {% if current_tags %}
          <div class="blog-list-box blog-list-{{ forloop.index }}" data-handle="{{ blog_title }}">
            <grid-list class="main-blog__items f-grid f-grid-1-cols md:f-grid-3-cols lg:f-grid-3-cols f-grid--gap-extra-large">
              {% for article in blog.articles %}
                {% if article.tags contains current_tags.first %}
                  {%- render 'card-article',
                    article: article,
                    show_date: true,
                    show_excerpt: true,
                    show_button: true,
                    index: forloop.index,
                    title_size: h3
                  -%}
                {% endif %}
              {% endfor %}
            </grid-list>
            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          </div>
        {% else %}
          <div class="blog-list-box blog-list-{{ forloop.index }}" data-handle="{{ blog_title }}">
            <grid-list class="main-blog__items f-grid f-grid-1-cols md:f-grid-3-cols lg:f-grid-3-cols f-grid--gap-extra-large">
              {% for article in blog.articles %}
                {%- render 'card-article',
                  article: article,
                  show_date: true,
                  show_excerpt: true,
                  show_button: true,
                  index: forloop.index,
                  title_size: h3
                -%}
              {% endfor %}
            </grid-list>
            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

{% schema %}
{
  "name": "Main Blog New",
  "settings": [
    {
      "type": "textarea",
      "id": "blog_titles",
      "label": "所有blog类别",
      "info": "填写所有blog类别，以英文逗号分隔，例如：News,Learn,Activity"
    }
  ],
  "presets": [
    {
      "name": "Main Blog New"
    }
  ]
}
{% endschema %}
